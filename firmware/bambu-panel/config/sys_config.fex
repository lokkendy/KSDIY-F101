;sunxi platform application
;---------------------------------------------------------------------------------------------------------
; 说明： 脚本中的字符串区分大小写，用户可以修改"="后面的数值，但是不要修改前面的字符串
; 描述gpio的形式：Port:端口+组内序号<功能分配><内部电阻状态><驱动能力><输出电平状态>
;---------------------------------------------------------------------------------------------------------

;---------------------------------------------------------------------------------
; version:版本1.00
; machine:板级文件名
;---------------------------------------------------------------------------------
[product]
version = "1"
machine = "evb"

;----------------------------------------------------------------------------------
;debug_mode     = 0-close printf, > 0-open printf
;----------------------------------------------------------------------------------
[platform]
debug_mode  = 1

;----------------------------------------------------------------------------------
;storage_type   = boot medium, 0-nand, 1-sd, 2-emmc, 3-nor, 4-emmc3, 5-spinand -1(defualt)auto scan
;----------------------------------------------------------------------------------
[target]
storage_type    = 3

[spinor_para]
;read_mode           =4
;flash_size          =16
;delay_cycle         =1
;frequency           =100000000

spi0_sclk           = port:PC00<3><0><2><default>
spi0_cs             = port:PC01<3><1><2><default>
spi0_miso           = port:PC02<3><0><2><default>
spi0_wp             = port:PC03<3><0><2><default>
spi0_mosi           = port:PC04<3><0><2><default>
spi0_hold           = port:PC05<3><0><2><default>

[spif0]
spif_sclk           = port:PC00<4><0><3><default>
spif_cs             = port:PC01<4><1><3><default>
spif_miso           = port:PC02<4><0><3><default>
spif_wp             = port:PC03<4><1><3><default>
spif_mosi           = port:PC04<4><0><3><default>
spif_hold           = port:PC05<4><1><3><default>

[spi0]
spi0_sclk           = port:PC00<3><0><2><default>
spi0_cs             = port:PC01<3><1><2><default>
spi0_miso           = port:PC02<3><0><2><default>
spi0_wp             = port:PC03<3><0><2><default>
spi0_mosi           = port:PC04<3><0><2><default>
spi0_hold           = port:PC05<3><0><2><default>

[spi1]
; 本板未接 SPI1 外设（Nor 走 spi0@PC，屏走 MIPI DSI）。
; 若保留下列 GPIO，Boot/脚本可能把 PD0-5 配成 SPI1，与 PA(PD4)、UART4(PD6/7) 冲突。
;spi1_sclk           = port:PD01<3><0><3><default>
;spi1_cs             = port:PD00<3><1><2><default>
;spi1_mosi           = port:PD02<3><0><2><default>
;spi1_miso           = port:PD03<3><0><2><default>
;spi1_wp             = port:PD05<3><0><2><default>
;spi1_hold           = port:PD04<3><0><2><default>

[card_boot]
card_no = 2
;----------------------------------------------------------------------------------
;card_ctrl 		-卡量产相关的控制器选择0      |
;card_high_speed        -速度模式 0为低速，1为高速|
;card_line        	-4：4线卡，8：8线卡|
;sdc_d1  		-sdc卡数据1线信号的GPIO配置     |
;sdc_d0			-sdc卡数据0线信号的GPIO配置  |
;sdc_clk  		-sdc卡时钟信号的GPIO配置   |
;sdc_cmd       		-sdc命令信号的GPIO配置|
;sdc_d3  		-sdc卡数据3线信号的GPIO配置    |
;sdc_d2			-sdc卡数据2线信号的GPIO配置  |
;----------------------------------------------------------------------------------
[card0_boot_para]
card_ctrl       = 0
card_high_speed = 1
card_line       = 4
sdc_d1          = port:PF0<2><1><2><default>
sdc_d0          = port:PF1<2><1><2><default>
sdc_clk         = port:PF2<2><1><2><default>
sdc_cmd         = port:PF3<2><1><2><default>
sdc_d3          = port:PF4<2><1><2><default>
sdc_d2          = port:PF5<2><1><2><default>
bus-width = 4
cap-sd-highspeed =
cap-wait-while-busy =
no-sdio =
no-mmc =
sunxi-power-save-mode =


;----------------------------------------------------------------------------------
;card_ctrl  		-卡启动控制器选择2
;card_high_speed       	-速度模式 0为低速，1为高速
;card_line        	-4：4线卡，8：8线卡
;sdc_ds  		-ds信号的GPIO配置
;sdc_d1  		-sdc卡数据1线信号的GPIO配置
;sdc_d0			-sdc卡数据0线信号的GPIO配置
;sdc_clk  		-sdc卡时钟信号的GPIO配置
;sdc_cmd       		-sdc命令信号的GPIO配置
;sdc_d3  		-sdc卡数据3线信号的GPIO配置
;sdc_d2			-sdc卡数据2线信号的GPIO配置
;sdc_d4  		-sdc卡数据4线信号的GPIO配置
;sdc_d5			-sdc卡数据5线信号的GPIO配置
;sdc_d6 	 	-sdc卡数据6线信号的GPIO配置
;sdc_d7			-sdc卡数据7线信号的GPIO配置
;sdc_emmc_rst  		-emmc_rst信号的GPIO配置
;sdc_ex_dly_used  	-ex_dly_used信号
;sdc_io_1v8  		-sdc_io_1v8高速emmc模式配置
;----------------------------------------------------------------------------------
[card2_boot_para]
card_ctrl       = 2
card_high_speed = 1
card_line       = 4
sdc_clk         = port:PC0<2><1><2><default>
sdc_cmd         = port:PC1<2><1><2><default>
sdc_d0          = port:PC4<2><1><2><default>
sdc_d1          = port:PC3<2><1><2><default>
sdc_d2          = port:PC2<2><1><2><default>
sdc_d3          = port:PC5<2><1><2><default>

;----------------------------------------------------------------------------------
;twi configuration
;twi_used	0：关闭, 1：打开
;twi_port	0:twi0,  1:twi1, 2:twi2, 3:twi3, 4:twi4, 5:twi5, 6:r_twi0, 7:r_twi1
;twi_scl	boot0 scl的GPIO配置
;twi_sda	boot0 sda的GPIO配置
;----------------------------------------------------------------------------------
;[twi_para]
;twi_used = 0
;twi_port = 2
;twi_scl  = port:PC0<3><1><0><default>
;twi_sda  = port:PC1<3><1><0><default>

[twi0]
twi_used = 1
twi_port = 0
twi_scl  = port:PE2<4><1><0><default>
twi_sda  = port:PE3<4><1><0><default>

[twi1]
twi_used = 1
twi_port = 1
twi_drv_used = 0
; Schematic: PD0 TWI1_SCL / PD1 TWI1_SDA (Function4).
twi_scl = port:PD00<4><1><0><default>
twi_sda = port:PD01<4><1><0><default>

[twi2]
twi_used = 1
twi_port = 2
twi_scl  = port:PE4<4><1><0><default>
twi_sda  = port:PE5<4><1><0><default>

;----------------------------------------------------------------------------------
;capacitor tp configuration
;external int function
;wakeup output function
;ctp_driver			-驱动IC名称
;ctp_modify_reg			-xy交换
;ctp_reverse_x			-x坐标极性反转
;ctp_reverse_y			-y坐标极性反转
;----------------------------------------------------------------------------------
[ctp_para]
ctp_used                = 1
; ST7123（4.3" 480x800 incell）用 TWI1；若上板 I2C NACK 先确认 twi 总线号
ctp_twi_id              = 1
ctp_twi_addr            = 0xAA
; 驱动名必须是 sunxi_st7123，对应 tpdev/st7123.c 里 .name 字段，
; 否则 ctp 框架找不到驱动，日志会报 "ctp driver not found"
ctp_driver              = "sunxi_st7123"
; 触摸坐标范围必须与面板分辨率一致（480x800）。
; ST7123 芯片自身会报 MaxX/MaxY，驱动里已做兜底，但这里仍写正确值，
; 保证 CTP 框架按面板尺寸做边界裁剪。
ctp_screen_max_x        = 480
ctp_screen_max_y        = 800
; 坐标方向修正：4.3" 屏装到本板后若方向反了，改这两个值
;   ctp_reverse_x / ctp_reverse_y: 1=反向, 0=正向
ctp_reverse_x           = 0
ctp_reverse_y           = 0
ctp_modify_reg          = 0
 ; In-cell shared boot reset: LCD_RST PD9 and TP_RST PD3.
; Both reset lines are owned by ksdiy_incell_reset_once(), not individual drivers.
ctp_int_port = port:PD02<0><1><3><default>
ctp_wakeup = port:PD03<1><0><3><1>

;----------------------------------------------------------------------------------
;jtag_enable  	|JTAG使能   |
;jtag_ms        |测试模式选择输入(TMS) 的GPIO配置|
;jtag_ck 	|测试时钟输入(CLK) 的GPIO配置    |
;jtag_do	|测试数据输出(TDO) 的GPIO配置     |
;jtag_di	|测试数据输出(TDI) 的GPIO配置     |
;----------------------------------------------------------------------------------
[jtag_para]
jtag_enable     = 0
jtag_ms         = port:PF0<4><default><default><default>
jtag_ck         = port:PF5<4><default><default><default>
jtag_do         = port:PF3<4><default><default><default>
jtag_di         = port:PF1<4><default><default><default>

;*****************************************************************************
;sdram configuration
;说明：lpsram时未使用 252-->348
;*****************************************************************************
[dram_para]
dram_clk            = 348
dram_type           = 3
dram_zq             = 0x7bfbfb
dram_odt_en         = 0x0
dram_para1          = 0x00000010
dram_para2          = 0x00000000
dram_mr0            = 0x0
dram_mr1            = 0x0
dram_mr2            = 0x0
dram_mr3            = 0x0
dram_tpr0           = 0x0
dram_tpr1           = 0x0
dram_tpr2           = 0x0
dram_tpr3           = 0x0
dram_tpr4           = 0x0
dram_tpr5           = 0x0
dram_tpr6           = 0x0
dram_tpr7           = 0x0
dram_tpr8           = 0x0
dram_tpr9           = 0x0
dram_tpr10          = 0x0
dram_tpr11          = 0x0
dram_tpr12          = 0x0
dram_tpr13          = 0x0

;----------------------------------------------------------------------------------
;standby wakeup source config
;---| interrupt num | module name  |
;---|     5         |     uart3    |
;---|     57        |     gpadc    |
;---|     144       |     rtc      |
;----------------------------------------------------------------------------------
[standby_para]
standby_irq_num0 = 5
standby_irq_num1 = 57
standby_irq_num2 = 144

;----------------------------------------------------------------------------------
;uart configuration
;uart_debug_port  |Boot串口控制器编号        |
;uart_debug_tx       |Boot串口发送的GPIO配置|
;uart_debug_rx  |Boot串口接收的GPIO配置     |
;----------------------------------------------------------------------------------
[uart_para]
; JP1 console: PD6 TX / PD7 RX, UART4, 115200 8N1.
; F101 User Manual Table 16-18: PD6/PD7 UART4 is Function5.
; Function6 on PD6/PD7 is PWM0-0/PWM0-1; PE2/PE3 use a different mux.
uart_debug_port = 4
uart_debug_baudrate = 115200
uart_debug_tx   = port:PD06<5><1><default><default>
uart_debug_rx   = port:PD07<5><1><default><default>

[uart0]
; PE00/PE01 与 sdc2 的 D1/D0 冲突，已让给 AIC8800 SDIO。
; 保留段但不分配引脚，串口日志因此不可用，改走 ADB。
;uart_tx   = port:PE00<6><1><default><default>
;uart_rx   = port:PE01<6><1><default><default>
;dma_tx_used = 0
;dma_rx_used = 0

[uart1]
; PE10 让给 AIC8800 REG_ON；PD22 与 LCD PWM7 冲突。
; 本板不使用 uart1。
;uart_tx   = port:PE10<6><1><default><default>
;uart_rx   = port:PD22<5><1><default><default>
;dma_tx_used = 0
;dma_rx_used = 0

[uart2]
; 蓝牙 HCI（H:4），115200，硬件流控
; TX=PE6 RX=PE7 RTS=PE8 CTS=PE9（mux=3，与 yuzukineko 一致）
; 注：CONFIG_DRIVERS_AIC8800 当前未启用，此段暂不生效，保留备用。
uart_tx   = port:PE06<3><1><default><default>
uart_rx   = port:PE07<3><1><default><default>
uart_rts  = port:PE08<3><1><default><default>
uart_cts  = port:PE09<3><1><default><default>
dma_tx_used = 0
dma_rx_used = 0

[uart4]
; RTOS HAL pinctrl for the same console selected by [uart_para].
; PD6/PD7 Function5 (not PE2/PE3 Function6).
uart_tx   = port:PD06<5><1><default><default>
uart_rx   = port:PD07<5><1><default><default>

[uart3]
; PE08/PE09 让给 uart2 作 RTS/CTS，本板不使用 uart3。
;uart_tx   = port:PE08<6><1><default><default>
;uart_rx   = port:PE09<6><1><default><default>
;dma_tx_used = 0
;dma_rx_used = 0

[gpadc_para]
gpadc_channel = 0
gpadc_power_vol = 1037
gpadc_lowdata_cmp_vol   = 1200
gpadc_use_power_key = 1

[spilcd_fb0]
spilcd_used            = 0
spilcd_model_name      = "spilcd"
spilcd_driver_name     = "kld2844b"
spilcd_x               = 320
spilcd_y               = 240
spilcd_width           = 60
spilcd_height          = 95
spilcd_data_speed      = 60
spilcd_pwm_used        = 1
spilcd_pwm_ch          = 0
spilcd_pwm_freq        = 5000
spilcd_pwm_pol         = 1
spilcd_if              = 1
spilcd_pixel_fmt       = 10
spilcd_dbi_fmt         = 2
spilcd_dbi_clk_mode    = 1
spilcd_dbi_te          = 0
spifb_buffer_num       = 2
spilcd_dbi_if          = 4
spilcd_rgb_order       = 0
spilcd_fps             = 60
spilcd_spi_bus_num     = 1
spilcd_frm             = 1
spilcd_gamma_en        = 1
spilcd_backlight       = 100
spilcd_power_num       = 0
spilcd_gpio_regu_num   = 0
spilcd_bl_percent_num  = 0

;spilcd_gpio_0 = port:PD04<1><1><3><1>
;spilcd_spi_te_pin = port:PD05<0><1><3><1>

;spilcd_spi_dc_pin      = port:PA19<1><0><3><0>

;------------------------------------------------------------------------------
;pwm config
;------------------------------------------------------------------------------
[pwm2]
; F101 Table 16-18: LCD_BL PD22 is Function4 PWM0-2.
pwm_pin = port:PD22<4><default><default><default>

;----------------------------------------------------------------------------------
;disp init configuration
;
;disp_mode             (0:screen0<screen0,fb0>)
;de_dither_en          (0:disable; 1:enable)
;de_dither_fmt         (0: 888; 1:444; 2:565; 3:666)
;de_dither_mode        (0：Quantization; 1：Floyd-Steinberg; 3：Ordered(565/666 not supported); 4：Sierra Lite; 5：Burkes)
;de_dither_width       (width)
;de_dither_height      (height)
;screenx_output_type   (0:none; 1:lcd; 3:hdmi;)
;screenx_output_mode   (used for hdmi output, 0:480i 1:576i 2:480p 3:576p 4:720p50)
;                      (5:720p60 6:1080i50 7:1080i60 8:1080p24 9:1080p50 10:1080p60)
;fbx format            (4:RGB655 5:RGB565 6:RGB556 7:ARGB1555 8:RGBA5551 9:RGB888 10:ARGB8888 12:ARGB4444)
;fbx pixel sequence    (0:ARGB 1:BGRA 2:ABGR 3:RGBA)
;fb0_scaler_mode_enable(scaler mode enable, used FE)
;fbx_width,fbx_height  (framebuffer horizontal/vertical pixels, fix to output resolution while equal 0)
;lcdx_backlight        (lcd init backlight,the range:[0,256],default:197
;lcdx_yy               (lcd init screen bright/contrast/saturation/hue, value:0~100, default:50/50/57/50)
;lcd0_contrast         (LCD contrast, 0~100)
;lcd0_saturation       (LCD saturation, 0~100)
;lcd0_hue              (LCD hue, 0~100)
;----------------------------------------------------------------------------------
[disp]
disp_init_enable         = 1
disp_mode                = 0

de_dither_en             = 1
de_dither_fmt            = 3
de_dither_mode           = 4
de_dither_width = 480
de_dither_height = 800

screen0_output_type      = 1
screen0_output_mode      = 4

screen0_output_format    = 1
screen0_output_bits      = 0
screen0_output_eotf      = 4
screen0_output_cs        = 257
screen0_output_dvi_hdmi  = 2
screen0_output_range     = 2
screen0_output_scan      = 0
screen0_output_aspect_ratio = 8

screen1_output_type      = 1
screen1_output_mode      = 4
screen1_output_format    = 1
screen1_output_bits      = 0
screen1_output_eotf      = 4
screen1_output_cs        = 260
screen1_output_dvi_hdmi  = 2
screen1_output_range     = 2
screen1_output_scan      = 0
screen1_output_aspect_ratio = 8


fb0_format               = 0
fb0_width                = 0
fb0_height               = 0

fb1_format               = 0
fb1_width                = 0
fb1_height               = 0

lcd0_backlight           = 50
lcd1_backlight           = 50

lcd0_bright              = 50
lcd0_contrast            = 50
lcd0_saturation          = 57
lcd0_hue                 = 50

lcd1_bright              = 50
lcd1_contrast            = 50
lcd1_saturation          = 57
lcd1_hue                 = 50

;----------------------------------------------------------------------------------
;lcd0 configuration

;lcd_if:               0:hv(sync+de); 1:8080; 2:ttl; 3:lvds; 4:dsi; 5:edp; 6:extend dsi
;lcd_x:                lcd horizontal resolution
;lcd_y:                lcd vertical resolution
;lcd_width:            width of lcd in mm
;lcd_height:           height of lcd in mm
;lcd_dclk_freq:        in MHZ unit
;lcd_pwm_freq:         in HZ unit
;lcd_pwm_pol:          lcd backlight PWM polarity
;lcd_pwm_max_limit     lcd backlight PWM max limit(<=255)
;lcd_hbp:              hsync back porch
;lcd_ht:               hsync total cycle
;lcd_vbp:              vsync back porch
;lcd_vt:               vysnc total cycle
;lcd_hspw:             hsync plus width
;lcd_vspw:             vysnc plus width
;lcd_lvds_if:          0:single link;  1:dual link
;lcd_lvds_colordepth:  0:8bit; 1:6bit
;lcd_lvds_mode:        0:NS mode; 1:JEIDA mode
;lcd_frm:              0:disable; 1:enable rgb666 dither; 2:enable rgb656 dither
;lcd_io_phase:         0:noraml; 1:intert phase(0~3bit: vsync phase; 4~7bit:hsync phase;
;                      8~11bit:dclk phase; 12~15bit:de phase)
;lcd_gamma_en          lcd gamma correction enable
;lcd_bright_curve_en   lcd bright curve correction enable
;lcd_cmap_en           lcd color map function enable
;deu_mode              0:smoll lcd screen; 1:large lcd screen(larger than 10inch)
;lcdgamma4iep:         Smart Backlight parameter, lcd gamma vale * 10;
;                      decrease it while lcd is not bright enough; increase while lcd is too bright
;smart_color           90:normal lcd screen 65:retina lcd screen(9.7inch)
;lcd_hs_trail_set      set value of dsi: 0x1010[31:24] to set dphy hs trail，hs_tail = (lcd_hs_trail_set + 2)*Tbyteclk+(2~3)*Tclk-(3~4)*Tclkd8
;lcd_clk_trail_set      set value of dsi: 0x1018[7:0] to set clock trail,clk_trail = (lcd_clk_trail_set + 2)*tclk
;----------------------------------------------------------------------------------
;LVDS single link  1366*768
;[lcd0]
;lcd_used            = 1
;lcd_driver_name     = "default_lcd"
;lcd_backlight       = 50
;lcd_if              = 3
;lcd_x               = 1368
;lcd_y               = 768
;lcd_width           = 150
;lcd_height          = 94
;lcd_dclk_freq       = 68
;lcd_pwm_used        = 1
;lcd_pwm_ch          = 3
;lcd_pwm_freq        = 20000
;lcd_pwm_pol         = 0
;lcd_pwm_max_limit   = 100
;lcd_hbp             = 80
;lcd_ht              = 1478
;lcd_hspw            = 32
;lcd_vbp             = 12
;lcd_vt              = 790
;lcd_vspw            = 4
;lcd_lvds_if         = 0
;lcd_lvds_colordepth = 1
;lcd_lvds_mode       = 0
;lcd_frm             = 1
;lcd_hv_clk_phase	= 0
;lcd_hv_sync_polarity	= 0
;lcd_gamma_en        = 0
;lcd_bright_curve_en = 0
;lcd_cmap_en         = 0
;deu_mode            = 0
;lcdgamma4iep        = 22
;smart_color         = 90

;lcd_bl_en           = port:PD08<1><0><3><1>

;lcd_gpio_0               = port:PD12<3><0><3><default>
;lcd_gpio_1               = port:PD13<3><0><3><default>
;lcd_gpio_2               = port:PD14<3><0><3><default>
;lcd_gpio_3               = port:PD15<3><0><3><default>
;lcd_gpio_4               = port:PD16<3><0><3><default>
;lcd_gpio_5               = port:PD17<3><0><3><default>
;lcd_gpio_6               = port:PD18<3><0><3><default>
;lcd_gpio_7               = port:PD19<3><0><3><default>
;lcd_gpio_8               = port:PD20<3><0><3><default>
;lcd_gpio_9               = port:PD21<3><0><3><default>

;DSI
[lcd0]
lcd_used            = 1
lcd_if              = 4
lcd_rgb_swap         = 0
lcd_pwm_used        = 1
lcd_pwm_ch = 2
lcd_pwm_freq        = 20000
lcd_pwm_pol         = 1
lcd_pwm_max_limit   = 100

;; TFT0268_376x960  2xLanes
;lcd_driver_name     = "mipi_tft055_720x1280"
;lcd_x               = 376
;lcd_y               = 960
;lcd_width           = 27
;lcd_height          = 68
;lcd_hbp             = 160
;lcd_ht              = 636
;lcd_hspw            = 20
;lcd_vbp             = 40
;lcd_vt              = 1030
;lcd_vspw            = 10
;lcd_dsi_lane        = 2
;lcd_dclk_freq       = 32
;lcd_backlight       = 30

;; TFT0458_568x1210  AMOLED 2xLanes
;lcd_driver_name     = "mipi_tft055_720x1280"
;lcd_x               = 568
;lcd_y               = 1210
;lcd_width           = 47
;lcd_height          = 101
;lcd_hbp             = 250
;lcd_ht              = 1072
;lcd_hspw            = 4
;lcd_vbp             = 12
;lcd_vt              = 1250
;lcd_vspw            = 4
;lcd_dsi_lane        = 2
;lcd_dclk_freq       = 68
;lcd_backlight       = 30

;; TFT0495_960x544  AMOLED 2xLanes
;lcd_driver_name     = "mipi_tft055_720x1280"
