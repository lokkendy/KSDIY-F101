;; ST7102_480x800  4.3" incell touch  2Lanes
;;
;; 参数来源：ESP32-P4 工程 components/esp_lcd_st7102
;;   ST7102_VIDEO_TIMING_480_800():
;;     h_size=480  hsync_back_porch=40  hsync_pulse_width=2  hsync_front_porch=40
;;     v_size=800  vsync_back_porch=10  vsync_pulse_width=2  vsync_front_porch=310
;;   ST7102_MIPI_480_800_PANEL_60HZ_DPI_CONFIG(): dpi_clock = 37.8 MHz
;;
;; 换算（全志的 ht/vt 含前后肩）：
;;   lcd_ht = 480 + 40 + 2 + 40  = 562
;;   lcd_vt = 800 + 10 + 2 + 310 = 1122
;;   刷新率 = 38e6 / 562 / 1122 = 60.3 Hz
lcd_driver_name     = "mipi_st7102_480x800"
lcd_x               = 480
lcd_y               = 800
lcd_width           = 55
lcd_height          = 92
lcd_hbp = 42
lcd_ht              = 562
; F101 DSI video packets require >=10 bytes HSA (4 RGB888 pixels).
; Keep cumulative HBP=42 and HT=562: active start and line period unchanged.
lcd_hspw            = 4
lcd_vbp = 12
lcd_vt              = 1122
lcd_vspw            = 2
lcd_dsi_lane        = 2
lcd_dclk_freq       = 38
lcd_backlight       = 100

