 ; LCD_RST/TP_RST are reset together once before disp_probe().
; No lcd_gpio_reset or reset-on/exit-sequence: no later individual pulses.
lcd_gpio_0               = port:PD12<4><0><3><default>
lcd_gpio_1               = port:PD13<4><0><3><default>
lcd_gpio_2               = port:PD14<4><0><3><default>
lcd_gpio_3               = port:PD15<4><0><3><default>
lcd_gpio_4               = port:PD16<4><0><3><default>
lcd_gpio_5               = port:PD17<4><0><3><default>

[audiocodec]
dac_vol			= 63
dacl_vol		= 160
lineout_gain		= 31
lineoutl_en		= 1
spk_en			= 1
hpout_en		= 0
playback_cma		= 16
capture_cma		= 16
pa_msleep_time		= 10
; 功放使能：PD4（本板实测的 PA 使能引脚）
pa_pin			= port:PD04<1><default><1><1>

[daudio0]
tdm_num			= 0
daudio_master		= 4
audio_format		= 1
signal_inversion	= 1
pcm_lrck_period		= 64
slot_width_select	= 32
msb_lsb_first		= 0
frametype		= 0
tx_data_mode		= 0
rx_data_mode		= 0
tdm_config		= 1
mclk_div		= 1
rx_sync_en		= 0
rx_sync_ctl		= 0
playback_cma		= 64
capture_cma		= 64
i2s0_mclk		= port:PI3<2><0><1><default>
i2s0_bclk		= port:PI0<2><0><1><default>
i2s0_lrck		= port:PI1<2><0><1><default>
i2s0_din0		= port:PI2<2><0><1><default>

[dmic]
capture_cma		= 16

[owa]
playback_cma		= 16
capture_cma		= 16
[osal_cfg_test]
test_key_value = 0
test_gpio1 = port:PA16<5><1><default><default>
test_gpio2 = port:PA17<5><1><default><default>

;--------------------------------
;[usbc0]：控制器0的配置。
;usb_used：USB使能标志。置1，表示系统中USB模块可用,置0,则表示系统USB禁用。
;usb_port_type：USB端口的使用情况。 0：device only;1：host only;2：OTG
;usb_detect_type：USB端口的检查方式。0：不做检测;1：vbus/id检查;2：id/dpdm检查
;usb_detect_mode：USB端口的检查方式。0：线程轮询;1：id中断触发
;usb_id_gpio：USB ID pin脚配置。具体请参考gpio配置说明。
;usb_det_vbus_gpio：USB DET_VBUS pin脚配置。具体请参考gpio配置说明。
;usb_drv_vbus_gpio：USB DRY_VBUS pin脚配置。具体请参考gpio配置说明。
;usb_drv_vbus_type:	vbus设置方式。0：无; 1：gpio; 2：axp。
;usb_det_vbus_gpio: "axp_ctrl",表示axp 提供
;usb_restrict_gpio  usb限流控制pin
;usb_restric_flag:  usb限流标置
;usbh_driver_level:	usb做host时驱动能力0x0-0xf
;usbd_driver_level:	usb做device时驱动能力0x0-0xf
;usbh_irq_flag:	usb host中断标志 设置为0x4000可为唤醒源，设置为0不具有唤醒功能。
;usbd_irq_flag: usb device中断标志 设置为0x4000可为唤醒源，设置为0不具有唤醒功能。
;--------------------------------
;--------------------------------
;---       USB0控制标志
;--------------------------------
[usbc0]
usb_used                = 1
; 0 = device only（ADB / 烧录用），1 = host only（U盘），2 = OTG
; 本板单 USB 口，用作 device 模式跑 adbd，
; 配合串口 `reboot efex` 可直接进烧录，不用反复插拔。
usb_port_type           = 0
usb_detect_type         = 1
usb_detect_mode		    = 0
; device 模式下不需要 VBUS 供电输出，注释掉避免干扰
;usb_drv_vbus_gpio       = port:PE02<1><0><default><0>
usb_drv_vbus_type       = 0
usb_host_init_state     = 0
usb_restric_flag        = 0
usb_restric_voltage     = 3550000
usb_restric_capacity    = 5
usbd_irq_flag			= 0
usbh_irq_flag			= 0

;-----------------------------------------------------------------------------
;sunxi rtos audio driver v2
;-----------------------------------------------------------------------------
[i2s0_mach]
format = "i2s"
bitclock-inversion = 0
frame-inversion = 0
bitclock-master = "cpu"
frame-master = "cpu"
slot-num = 2
slot-width = 32
playback-only = 0
capture-only = 0
cpu-pll-fs = 1
mclk-fs = 1
mclk-fp = "11289600,12288000"
codec-pll-fp = "22579200, 24576000"
codec-pllin-mode = 0
codec-pllin-fs = 1
codec-pllout-mode = 0
codec-pllout-fs = 1
cpu = "i2s0_plat"
cpu-id = 0

;[i2s0_plat]
;playback-cma		= 8
;capture-cma		= 8
;tdm-num			= 0
;tx-pin			= "0"
;tx-pin0-chmap		= "0,1,2,3"
;rxfifo-pinmap		= "0,0,0,0"
;rxfifo-chmap		= "0,1,2,3"
;tx-lsb-first		= "false"
;rx-lsb-first		= "false"
;i2s-pins-0		= port:PE0<5><0><1><default>
;i2s-pins-1		= port:PE1<5><0><1><default>
;i2s-pins-2		= port:PE2<5><0><1><default>
;i2s-pins-3		= port:PE3<5><0><1><default>
;i2s-pins-5		= port:PE4<5><0><1><default>

[codec_mach]
cpu = "codec_plat"
codecs-num = 1
codecs-0 = "codec"

[codec_plat]
playback_cma	= 8
capture_cma		= 8

[codec]
dac_vol	= 63
dacl_vol	= 160
dacr_vol	= 160
hpout_gain	= 7
adc1_vol	= 160
adc1_gain	= 15
lineinl_gain	= 6
fminl_gain	= 6
adcdrc_en     	= 0
adchpf_en     	= 0
dacdrc_en     	= 0
dachpf_en     	= 0
adc1_src	= 1
hpoutl_en	= 1
hpoutr_en	= 1
spk_en		= 1
pa-pin-max  = 1
; 功放使能：PD4（与 [audiocodec] 的 pa_pin 保持一致）
; 原值 PD7 已让给 UART4 RX（调试串口）
pa-pin-0    = port:PD04<1><default><1><1>
pa-pin-msleep-0 = 100

[owa_mach]
playback-only = 1
cpu = "owa_plat"

[owa_plat]
playback-cma	= 8
capture-cma		= 8
;owa-pins-0		= port:PE6<6><0><1><default>

;----------------------------------------------------------------------------------
;i2c configuration
;twi_drv_used : 是否使用TWI的drv工作模式，drv工作模式是芯片的IP功能，不是指的TWI的软件驱动，详情请参考芯片手册。
;----------------------------------------------------------------------------------
;[twi1]
;twi_drv_used    = 0
;twi1_scl         = port:PE00<4><1><0><default>
;twi1_sda         = port:PE01<4><1><0><default>

;----------------------------------------------------------------------------------
;resistance tp configuration
;----------------------------------------------------------------------------------
[rtp_para]
rtp_used 				= 0
rtp_adjust_cfg_path     = "/data/tp.cfg"
rtp_screen_max_x        = 1024
rtp_screen_max_y        = 600

[sdcard_global]
used_card_no    = 0x01
;used_card_no = 0x01, when use card0
;used_card_no = 0x02, when use card1
;used_card_no = 0x03, when use card0 & card1
internal_card = 0x00
;internal_card = 0x00, 无内置卡内置卡
;internal_card = 0x01, card0 做内置卡
;internal_card = 0x02, card1 做内置卡
;如果该卡是内置卡，则检测脚未注释，也不会使用
[sdc0_gpios]
detect_pin  = port:PF6<0><1><3><default>
;[sdc1det_para]
;msdet_para   = port:PG6<0><1><1><default>

[sdc0]
sdc0_used          = 1
bus-width      = 4
sdc0_d1            = port:PF00<2><1><2><default>
sdc0_d0            = port:PF01<2><1><2><default>
sdc0_clk           = port:PF02<2><1><2><default>
sdc0_cmd           = port:PF03<2><1><2><default>
sdc0_d3            = port:PF04<2><1><2><default>
sdc0_d2            = port:PF05<2><1><2><default>
;cd-gpios           = port:PF06<0><1><2><default>
;card-pwr-gpios     = port:PL08<1><1><2><default>
;ctl-spec-caps      = 0x4
;sunxi-power-save-mode =
;sunxi-dis-signal-vol-sw =
;vmmc="vcc-sdcv"
;vqmmc="vcc-sdcvq33"
;vdmmc="vcc-sdcvd"
;mmc-ddr-3_3v    = 1
;sd-uhs-sdr50 = 1
;sd-uhs-ddr50 = 1
;sd-uhs-sdr104 = 1
max-frequency   = 50000000


[sdc2]
sdc2_used = 1
bus-width= 4
; AIC8800 SDIO 4-bit，引脚按 yuzukineko 参考设计：
;   CLK=PE2  CMD=PE3  D0=PE1  D1=PE0  D2=PE5  D3=PE4  (mux=9)
sdc2_clk = port:PE2<9><1><2>
sdc2_cmd = port:PE3<9><1><2>
sdc2_d0 = port:PE1<9><1><2>
sdc2_d1 = port:PE0<9><1><2>
sdc2_d2 = port:PE5<9><1><2>
sdc2_d3 = port:PE4<9><1><2>
; AIC8800 焊在板上，不存在卡检测
;cd-gpios = port:PF06<0><1><2><default>
;ctl-spec-caps = 0x4
;sunxi-power-save-mode = 1
;sunxi-dis-signal-vol-sw = 1
;sd-uhs-sdr50 = 1
;sd-uhs-ddr50 = 1
;sd-uhs-sdr104 = 1
;vmmc="vcc-sdcv"
;vqmmc="vcc-sdcvq33"
;vdmmc="vcc-sdcvd"
max-frequency = 50000000

[wifi_para]
wifi_used = 1
; ── AIC8800D40L（WiFi + BLE 二合一），引脚与 YuzukiNeko 参考板一致 ──
;
; WiFi 数据面：SDC2 4-bit（见上方 [sdc2]）
;   CLK=PE2  CMD=PE3  D0=PE1  D1=PE0  D2=PE5  D3=PE4   (mux=9)
; 蓝牙数据面：UART2（4 线带流控）
;   TX=PE6  RX=PE7  RTS=PE8  CTS=PE9                    (mux=3)
; 控制脚：
;   WL_REG_ON = PE10（高有效，整片供电使能）
;   BT_RST_N  = PD8 （低有效复位；启用蓝牙时禁止将 PD8 当按键）
; SDIO 中断走 DAT1 线，不需要单独的 host-wake 脚。

wifi_reg_on = port:PE10<1><0><default><default>
wifi_reg_on_valid = 1
wifi_sdc_id = 2

; ── 内置 WiFi 凭据（上电自动连接） ────────────────────────────
;
; 首次烧录时 NVS 为空，没有这个配置就要先手动进设置页连 WiFi。
; 这里填上之后，开机即自动连该网络。
; 用户在设置页连过别的网络后，NVS 里的凭据优先于这里。
;
; 留空（wifi_sta_ssid = ""）则关闭自动连接。

; 蓝牙复位（AIC8800 的 BT_RST_N）
; LCD/TP 联合复位使用 PD9/PD3；PD8 专供蓝牙复位。
bt_reset = port:PD08<1><0><3><1>
bt_used = 1
bt_uart_id = 2
; ⚠ PD6/PD7 已让给 UART4 作调试串口（见 [uart_para]）。
;   蓝牙当前未启用（CONFIG_DRIVERS_BLUETOOTH_XRADIO / AIC8800 均为 n），
;   所以这里注释掉不影响功能。若以后要接 AIC8800 蓝牙，
;   需要把这两个脚改到其他空闲 GPIO，或把调试串口挪走。
;bt_wake_ap  = port:PD6<1><default><default><1>
;bt_wake_host = port:PD7<0><1><default><default>

[mbus]
mbus_master_config_num = 2

; RISCV - 
mbus_config_0_master = 39
mbus_config_0_master_limit = 500

; DE - 
mbus_config_1_master = 16
mbus_config_1_master_prior = 3
